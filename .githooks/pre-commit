#!/bin/sh
# Refuse a commit when the test suite fails.
# Enable once per clone with: git config core.hooksPath .githooks
# Tests that need the protein data or torch skip when those are missing.
# Use `git commit --no-verify` only to record a failing state on purpose, and say so in the message.
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"
echo "pre-commit: running the suite..."
if ! python3 -B -m unittest discover -s tests -q > /tmp/precommit_suite.txt 2>&1; then
    echo "pre-commit: refused, the suite is failing:"
    grep -E "^(FAIL|ERROR):" /tmp/precommit_suite.txt | head -20
    tail -3 /tmp/precommit_suite.txt
    echo "pre-commit: full output in /tmp/precommit_suite.txt"
    exit 1
fi
tail -2 /tmp/precommit_suite.txt | head -1
echo "pre-commit: ok"
