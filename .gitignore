# The two protein landscapes are downloaded by scripts/download_data.py.
data/

# Python
__pycache__/
*.pyc
.venv/
venv/

# API keys. The harness reads OPENROUTER_API_KEY from the environment.
.env

# Raw per-call logs written during a run. The repo keeps them as per-cell gzip archives under
# results/grid_<tag>_calls/, checked by scripts/archive_index.py.
results/grid_*_calls.jsonl
# The calls of an abandoned campaign are kept as plain JSONL.
!results/grid_*_abandoned_calls.jsonl

# LaTeX build products. The PDF is committed.
paper/main.log
paper/main.blg
paper/main.aux
paper/main.bbl
paper/main.out

# Files written while a job runs.
results/pids/
results/*.log
results/*.pid
results/*_stdout.txt
results/*_health.json
results/*_spotcheck.txt

# Cache of the scorecard runs, rebuilt by scripts/wellocate_chunks.py. The results are in
# results/wellocate_scorecard.json and results/wellocate_noise_sweep.json.
results/wellocate_partial/

# Training outputs, rebuilt from the committed scripts and seeds.
training/out/
